{
  "name": "scrapscn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm templates:generate && next dev",
    "build": "pnpm templates:generate && rm -rf public/storybook storybook-static && storybook build -o storybook-static && mv storybook-static public/storybook && next build",
    "build:next": "pnpm templates:generate && next build",
    "start": "next start",
    "format": "oxfmt src scripts tests .storybook --write",
    "format:check": "oxfmt src scripts tests .storybook --check",
    "lint": "pnpm lint:oxlint",
    "lint:oxlint": "oxlint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "figma:parse": "node --test tests/figma/*.test.mjs && figma connect parse --exit-on-unreadable-files --skip-update-check",
    "figma:preview": "node scripts/figma-preview.mjs",
    "parity:generate": "node scripts/generate-parity-manifest.mjs",
    "text:generate": "node scripts/generate-text-tailwind.mjs",
    "parity:validate": "node scripts/validate-parity-manifest.mjs",
    "registry:build": "shadcn build",
    "test:registry": "pnpm registry:build && node --test tests/scripts/registry.test.mjs && node scripts/test-registry.mjs",
    "test:parity": "node --test tests/parity/*.test.mjs",
    "template:create": "node scripts/create-template.mjs",
    "templates:generate": "node scripts/generate-template-manifest.mjs",
    "test:playground": "pnpm build:next && node scripts/run-playwright.mjs tests/e2e/playground.spec.ts",
    "test:visual": "pnpm build:next && node scripts/run-playwright.mjs --config=playwright.visual.config.ts",
    "test:visual:update": "node scripts/validate-visual-update-host.mjs && pnpm build:next && node scripts/run-playwright.mjs --config=playwright.visual.config.ts --update-snapshots && node scripts/run-playwright.mjs --config=playwright.visual.config.ts",
    "visual:review": "node scripts/generate-visual-review.mjs",
    "visual:validate": "node scripts/validate-visual-evidence.mjs",
    "visual:canonical:capture": "node scripts/capture-canonical-visuals.mjs",
    "visual:local:capture": "node scripts/capture-local-paired-visuals.mjs",
    "test:figma-capture": "pnpm build:next && node scripts/test-production-capture.mjs && node scripts/run-playwright.mjs tests/e2e/figma-capture-production.spec.ts && SCRAPSCN_E2E_MODE=development node scripts/run-playwright.mjs tests/e2e/figma-capture.spec.ts",
    "test:production-assets": "pnpm build:next && pnpm build-storybook && node --test tests/production/*.test.mjs",
    "test:templates": "node --test tests/templates/*.test.mjs && pnpm templates:generate && node scripts/test-templates.mjs && pnpm build:next && node scripts/run-playwright.mjs tests/e2e/templates.spec.ts",
    "test": "node --test tests/scripts/*.test.mjs && pnpm test:parity && vitest run",
    "verify": "pnpm test && pnpm exec tsc --noEmit && pnpm format:check && pnpm lint && pnpm visual:validate && pnpm build && pnpm test:playground && pnpm test:templates && pnpm test:registry && pnpm figma:parse && pnpm test:visual"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@floating-ui/dom": "1.7.6",
    "@fontsource-variable/roboto-mono": "5.2.9",
    "@fontsource/rubik": "^5.2.8",
    "@popperjs/core": "2.11.8",
    "@react-aria/button": "3.15.1",
    "@react-aria/disclosure": "3.2.1",
    "@react-aria/focus": "3.22.1",
    "@react-aria/gridlist": "3.15.1",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/interactions": "3.28.1",
    "@react-aria/listbox": "3.16.1",
    "@react-aria/numberfield": "3.13.1",
    "@react-aria/radio": "3.13.1",
    "@react-aria/separator": "3.5.1",
    "@react-aria/slider": "3.9.1",
    "@react-aria/tabs": "3.12.1",
    "@react-aria/utils": "3.34.1",
    "@react-aria/visually-hidden": "3.9.1",
    "@react-stately/collections": "3.13.1",
    "@react-stately/disclosure": "3.1.1",
    "@react-stately/list": "3.14.1",
    "@react-stately/numberfield": "3.12.1",
    "@react-stately/radio": "3.12.1",
    "@react-stately/slider": "3.8.1",
    "@react-stately/tabs": "3.9.1",
    "@react-types/shared": "3.36.0",
    "@sentry/react": "10.69.0",
    "@tanstack/react-form": "1.28.6",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "3.14.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "5.0.2",
    "focus-trap": "8.2.2",
    "framer-motion": "12.38.0",
    "input-otp": "^1.5.0",
    "isomorphic-dompurify": "2.20.0",
    "lucide-react": "^1.16.0",
    "marked": "18.0.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "platformicons": "9.6.0",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "6.30.6",
    "react-textarea-autosize": "8.5.7",
    "shadcn": "4.8.2",
    "sprintf-js": "1.0.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "type-fest": "5.8.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@figma/code-connect": "2.0.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/history": "3.2.5",
    "@types/node": "^20",
    "@types/prismjs": "1.26.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-select": "4.0.18",
    "@types/sprintf-js": "1.1.4",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^24.1.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
