{
  "name": "scrapscn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm templates:generate && next dev",
    "build": "pnpm templates:generate && rm -rf public/storybook storybook-static && storybook build -o storybook-static && mv storybook-static public/storybook && next build",
    "build:next": "pnpm templates:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "figma:parse": "node --test tests/figma/*.test.mjs && figma connect parse --exit-on-unreadable-files --skip-update-check",
    "figma:preview": "node scripts/figma-preview.mjs",
    "parity:generate": "node scripts/generate-parity-manifest.mjs",
    "parity:validate": "node scripts/validate-parity-manifest.mjs",
    "test:parity": "node --test tests/parity/*.test.mjs",
    "template:create": "node scripts/create-template.mjs",
    "templates:generate": "node scripts/generate-template-manifest.mjs",
    "test:playground": "pnpm build:next && node scripts/run-playwright.mjs tests/e2e/playground.spec.ts",
    "test:figma-capture": "pnpm build:next && node scripts/test-production-capture.mjs && node scripts/run-playwright.mjs tests/e2e/figma-capture-production.spec.ts && SCRAPSCN_E2E_MODE=development node scripts/run-playwright.mjs tests/e2e/figma-capture.spec.ts",
    "test:templates": "node --test tests/templates/*.test.mjs && pnpm templates:generate && node scripts/test-templates.mjs && pnpm build:next && node scripts/run-playwright.mjs tests/e2e/templates.spec.ts",
    "test": "pnpm test:parity && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/serialize": "1.3.3",
    "@fontsource/roboto-mono": "^5.2.9",
    "@fontsource/rubik": "^5.2.8",
    "@react-aria/interactions": "3.28.1",
    "@react-aria/utils": "3.34.1",
    "@sentry/react": "^10.70.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "12.38.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@figma/code-connect": "2.0.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/prismjs": "1.26.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-storybook": "^10.4.1",
    "jsdom": "^24.1.3",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
